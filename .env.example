# RTL-SDR Konfiguration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# RTL-SDR Scanner Einstellungen
RTL_DEVICE_INDEX=0              # Index des USB Dongles (0 = erstes)
RTL_SAMPLE_RATE=2000000         # Sample-Rate in Hz (2 MSps optimal für RTL2838)
RTL_GAIN=auto                   # 'auto' oder fester Wert (0-49.6 dB)
                                # Typische feste Werte: '20.7', '25.4', '29.7', '35.0'
                                # Hinweis: Höherer Gain = mehr Empfindlichkeit aber mehr Rauschen

# InfluxDB Configuration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# ========================================================================
# MONITORED FREQUENCY BANDS (Maximal 2 Bänder) - EMI & Störungsüberwachung
# ========================================================================
# Wähle bis zu 2 Bänder numerisch aus (getrennt durch Komma)
# 
# === Breite Überblicks-Bänder (EMI-fokussiert) ===
#   0 = SMPS Harmonics (50-150 MHz)           Schaltnetzteile, Frequenzumrichter, PWM
#   1 = Motor Drives (100-300 MHz)            Frequenzumrichter, Motorsteuerungen, VFD
#   2 = Radio & Amateur (30-150 MHz)          UKW Funkgeräte, CB, Amateurfunk, PMR
#   3 = Industrial UHF (400-600 MHz)          Industriefunk, PMR446, Telemetrie
#   4 = WiFi 5G Low (470-600 MHz)             5G Sub-6 Band, Mikrowellenherde
#   5 = LTE & 4G (600-900 MHz)                Mobilfunk 4G/LTE, Zellular-Störungen
#   6 = Mobilfunk (850-2000 MHz)              GSM, UMTS, 4G/LTE, Handy-Abstrahlungen
#   7 = ISM & WLAN (2.4-2.5 GHz)              2.4 GHz WLAN, Bluetooth, Mikrowellenherde
#
# === Detaillierte Spektren für Fehlersuche ===
#   8 = Low VHF (30-80 MHz)                   Funkgeräte, Freifunk, Industriefunk
#   9 = Mid VHF (80-150 MHz)                  VHF Funkgeräte, Amateurfunk
#  10 = Motor/Drive Low (100-200 MHz)         VFD Grundfrequenzen & 1. Harmonics
#  11 = Motor/Drive High (200-400 MHz)        VFD Höhere Harmonics & Schalt-EMI
#  12 = Industrial Low (400-500 MHz)          Industriefunk, Telemetrie, Controls
#  13 = Industrial High (500-700 MHz)         Hochfrequenz-Industriefunk, Radare
#  14 = Microwave Low (900-1200 MHz)          Mikrowellenherde, 5G mmWave
#  15 = Microwave High (1200-1600 MHz)        Höherfrequente Mikrowellen, Radar
#
# === Kombinierte Monitoring-Bänder ===
#  16 = Alle Motorantriebe (100-700 MHz)      Gesamtes VFD & Motorsteuerungs-Spektrum
#  17 = Alle Funkquellen (30-1000 MHz)        Alle Funk-, PMR-, Industrial-Quellen
#  18 = RF Coupling Band (300-1000 MHz)       Kritischer Bereich für HF-Einkopplung
#  19 = Breitband EMI (50-2000 MHz)           Gesamt-Störspektrum
#  20 = High Interference Zone (400-600 MHz)  Höchste Stördichte-Zone
#  21 = Solar Inverter Harmonics (30-500 MHz) PV-Wechselrichter & SMPS Harmonics
#
# Beispiele:
#   MONITORED_BANDS=1,16     # Motorantriebe (VFD Probleme)
#   MONITORED_BANDS=0,21     # SMPS & Solaranlage (PV-Störungen)
#   MONITORED_BANDS=3,4      # Industriefunk & WiFi (externe Quellen)
#   MONITORED_BANDS=19       # Breitband-Überwachung (Problemfindung)
#   MONITORED_BANDS=20       # Hotspot-Zone (höchste Stordichte)
# ========================================================================
MONITORED_BANDS=1,21

# Scan-Intervall in Sekunden (schneller für bessere Zeitauflösung)
# Standard-Werte:
#   60   = 1 Minute (sehr häufig, mehr CPU-Last)
#   90   = 90 Sekunden
#   120  = 2 Minuten
#   180  = 3 Minuten (Standard, moderate Last)
#   300  = 5 Minuten (spart Ressourcen)
SCAN_INTERVAL_SECONDS=60

# RTL-SDR Gain Configuration (0-49.6 dB, höher = empfindlicher aber mehr Rauschen)
# Standard: 0 (Auto Gain), Hoch: 42.1, Sehr Hoch: 49.6
RTL_GAIN=42.1

# Automatischer Scan-Scheduler
# Scan-Intervall in Minuten (empfohlen: 3-5 Minuten)
SCAN_INTERVAL_MINUTES=3
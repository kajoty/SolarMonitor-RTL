# RTL-SDR Konfiguration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# RTL-SDR Scanner Einstellungen
RTL_DEVICE_INDEX=0              # Index des USB Dongles (0 = erstes)
RTL_SAMPLE_RATE=2000000         # Sample-Rate in Hz (2 MSps optimal für RTL2838)
RTL_GAIN=auto                   # 'auto' oder fester Wert (0-49.6 dB)
                                # Typische feste Werte: '20.7', '25.4', '29.7', '35.0'
                                # Hinweis: Höherer Gain = mehr Empfindlichkeit aber mehr Rauschen

# InfluxDB Configuration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# ========================================================================
# MONITORED FREQUENCY BANDS (Maximal 2 Bänder)
# ========================================================================
# Wähle bis zu 2 Bänder numerisch aus (getrennt durch Komma)
# 
# Verfügbare Bänder für RTL2838 DVB-T Stick:
#
# === Breite Bänder (Übersicht) ===
#   0 = VHF I (46-68 MHz)          Analog TV Band I / DAB
#   1 = FM Radio (87.5-108 MHz)    UKW Rundfunk
#   2 = VHF III (174-230 MHz)      Analog TV Band III
#   3 = UHF IV (470-606 MHz)       DVB-T Band IV (Hauptband)
#   4 = UHF V (606-862 MHz)        DVB-T Band V (Hauptband)
#   5 = GSM-900 (890-960 MHz)      Mobilfunk D1/D2
#   6 = GSM-1800 (1710-1880 MHz)   Mobilfunk D3
#   7 = ISM 2.4 GHz (2400-2500 MHz) WLAN/Bluetooth
#
# === Schmalere Sub-Bänder (Detailansicht) ===
#   8 = VHF I (46-54 MHz)          Analog TV Band I unten
#   9 = VHF I (54-68 MHz)          DAB / PMR
#  10 = FM Low (87.5-97.5 MHz)     UKW unten
#  11 = FM High (97.5-108 MHz)     UKW oben
#  12 = VHF III Low (174-192 MHz)  Analog TV Kanäle 5-7
#  13 = VHF III High (192-230 MHz) Analog TV Kanäle 8-12
#  14 = UHF IV Low (470-534 MHz)   DVB-T Kanäle 21-32
#  15 = UHF IV High (534-606 MHz)  DVB-T Kanäle 32-38
#  16 = UHF V Low (606-710 MHz)    DVB-T Kanäle 39-48
#  17 = UHF V High (710-862 MHz)   DVB-T Kanäle 48-60
#
# === Kombinierte Bänder ===
#  18 = Rundfunk (50-100 MHz)      VHF Rundfunk und TV Band I
#  19 = TV analog (100-230 MHz)    TV Band II + III
#  20 = Digital TV (470-862 MHz)   DVB-T Vollständig (Band IV+V)
#  21 = PMR/Funk (400-500 MHz)     PMR / Freifunk / Funkgeräte
#
# Beispiele:
#   MONITORED_BANDS=3,4      # UHF IV+V (DVB-T Hauptbänder) - EMPFOHLEN
#   MONITORED_BANDS=1,2      # FM Radio + VHF III
#   MONITORED_BANDS=0,1      # VHF I + FM Radio
#   MONITORED_BANDS=14,15    # UHF IV detailliert
#   MONITORED_BANDS=20       # Ganzes DVB-T Band
# ========================================================================
MONITORED_BANDS=3,4

# Scan-Intervall in Sekunden (schneller für bessere Zeitauflösung)
# Standard-Werte:
#   60   = 1 Minute (sehr häufig, mehr CPU-Last)
#   90   = 90 Sekunden
#   120  = 2 Minuten
#   180  = 3 Minuten (Standard, moderate Last)
#   300  = 5 Minuten (spart Ressourcen)
SCAN_INTERVAL_SECONDS=60

# RTL-SDR Gain Configuration (0-49.6 dB, höher = empfindlicher aber mehr Rauschen)
# Standard: 0 (Auto Gain), Hoch: 42.1, Sehr Hoch: 49.6
RTL_GAIN=42.1

# Automatischer Scan-Scheduler
# Scan-Intervall in Minuten (empfohlen: 3-5 Minuten)
SCAN_INTERVAL_MINUTES=3
# RTL-SDR Konfiguration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# RTL-SDR Scanner Einstellungen
RTL_DEVICE_INDEX=0              # Index des USB Dongles (0 = erstes)
RTL_SAMPLE_RATE=2000000         # Sample-Rate in Hz (2 MSps optimal für RTL2838)

# RTL_GAIN - Verfügbare Werte für RTL2838 Tuner (0-49.6 dB in 0.1 dB Schritten):
#
# === Empfohlene Werte ===
# 'auto'     = Automatische Gain-Anpassung (adaptiv, Standard)
# 0.0        = Keine Verstärkung (sehr rauscharm, aber schwache Signale)
# 10.0       = Niedrig (schwache externe Störungen, sauberes Spektrum)
# 20.7       = Mittel-Niedrig (Standard für Radioastronomy)
# 25.4       = Mittel (ausgewogen)
# 29.7       = Mittel-Hoch (für schwache Signale)
# 35.0       = Hoch (verstärkt Rauschen, aber auch schwache Signale)
# 42.1       = Sehr Hoch (gute Empfindlichkeit, etwas Rauschen)
# 49.6       = Maximum (sehr sensitiv, aber hohes Rauschen/Interferences)
#
# === Für Solar Radio Bursts empfohlen ===
# Type I/II/III: 20.7 oder 25.4    (balanciert, wenig Rauschen)
# Schwache Signale: 35.0 oder 42.1 (höhere Empfindlichkeit)
# Rauschen-Messung: 10.0 oder auto (Referenz/Kalibrierung)
#
RTL_GAIN=auto                   # Standard: auto, Empfehlung Solar: 25.4

# InfluxDB Configuration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# ========================================================================
# MONITORED FREQUENCY BANDS (Maximal 2 Bänder) - Solar Radio Astronomy
# ========================================================================
# Wähle bis zu 2 Bänder numerisch aus (getrennt durch Komma)
# 
# === Solar Radio Bursts & Cosmic Noise (klassische RadioAstronomy) ===
#   0 = Type I Solar Bursts (50-150 MHz)              Elektronische Streuungen Sonnencorona
#   1 = Type II/III Bursts (50-300 MHz)               Shockwaves & Electron Beams
#   2 = Decametric Solar (10-40 MHz)                  Dekametrische Strahlung (RTL-SDR Edge)
#   3 = Cosmic Noise (50-200 MHz)                     Galaktischer Hintergrund + Sonnenrauschen
#   4 = Galactic Synchrotron (100-500 MHz)            Galaxien-Synchrotronstrahlung
#   5 = Magnetospheric Disturbances (300-1000 MHz)    Magnetosphären-Störungen Sonnenwind
#   6 = Radiation Belt Whistlers (100-300 MHz)        Whistler Modus - Magnetosphären-Wellen
#   7 = Space Weather (50-1000 MHz)                   Breitband Space-Weather Monitoring
#
# === Detaillierte Solar Radio Bänder ===
#   8 = Metric Waves (10-200 MHz)                     Type II/III Bursts, Slow-Drift
#   9 = Dekametric Range (1-40 MHz)                   Dekametrische Strahlung (Edge)
#  10 = Centimetric Burst (500-3000 MHz)              Zentimetrische Strahlung Flares
#  11 = Microwave Solar (1000-2000 MHz)               Mikrowellen-Sonnenbeobachtung (Edge)
#  12 = Solar Electron Events (50-500 MHz)            Solare Elektronenereignisse
#  13 = Proton Events Signature (100-1000 MHz)        Solarer Protonenfluss-Signatur
#  14 = Solar Flare Continuum (100-600 MHz)           Kontinuums-Strahlung Flares
#  15 = Impulsive Flare (50-500 MHz)                  Impulsive Flare-Emission
#
# === Composite & Broadband Monitoring ===
#  16 = Complete Solar Band (10-1000 MHz)             Komplettes Sonnen-Monitoring
#  17 = Radio Astronomy Window (50-300 MHz)           Klassisches Radio-Astronomie Fenster
#  18 = Cosmic Ray Signature (200-1000 MHz)           Hochenergetische kosmische Strahlung
#  19 = Ionospheric Absorption (30-200 MHz)           Ionosphärische Absorption Solar Events
#  20 = Aurora Radio (50-150 MHz)                     Aurorale Radioemission (Nord-/Südlicht)
#  21 = Quiet Sun Noise (100-500 MHz)                 Ruhige Sonne Referenzmessung (Baseline)
#
# Beispiele:
#   MONITORED_BANDS=0,1      # Solar Type I/II/III Bursts (Standard)
#   MONITORED_BANDS=8,17     # Metric Waves + Radio Astronomy Window
#   MONITORED_BANDS=16       # Komplettes Sonnen-Monitoring
#   MONITORED_BANDS=3,4      # Cosmic Noise + Galactic Synchrotron
#   MONITORED_BANDS=20,21    # Aurora + Quiet Sun Baseline
# ========================================================================
MONITORED_BANDS=0,1

# Scan-Intervall in Sekunden (schneller für bessere Zeitauflösung)
# Standard-Werte:
#   60   = 1 Minute (sehr häufig, mehr CPU-Last)
#   90   = 90 Sekunden
#   120  = 2 Minuten
#   180  = 3 Minuten (Standard, moderate Last)
#   300  = 5 Minuten (spart Ressourcen)
SCAN_INTERVAL_SECONDS=60

# RTL-SDR Gain Configuration (0-49.6 dB, höher = empfindlicher aber mehr Rauschen)
# Standard: 0 (Auto Gain), Hoch: 42.1, Sehr Hoch: 49.6
RTL_GAIN=42.1

# Automatischer Scan-Scheduler
# Scan-Intervall in Minuten (empfohlen: 3-5 Minuten)
SCAN_INTERVAL_MINUTES=3
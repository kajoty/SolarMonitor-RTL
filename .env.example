# RTL-SDR Konfiguration
INFLUXDB_HOST=192.168.178.100
INFLUXDB_PORT=8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin
INFLUXDB_DATABASE=rtl_monitor

# RTL-SDR Scanning
RTL_FREQUENCIES=430000000,445000000
RTL_GAIN=25
RTL_PPM=0

# Continuous Scanning
CONTINUOUS_SCAN=true
SCAN_INTERVAL=5

# Dashboard
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

[Unit]
Description=SolarMonitor RTL-SDR Scanner
After=network.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/Projekte/scanner/SolarMonitor-RTL
Environment="PATH=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin"
ExecStart=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin/python3 frequency_scanner.py

[Install]
WantedBy=multi-user.target

[Unit]
Description=SolarMonitor-RTL Dashboard Service
Documentation=https://github.com/kajoty/SolarMonitor-RTL
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL

# Aktiviere Virtual Environment und starte Flask App
ExecStart=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL/venv/bin/python3 /home/pi/Projekte/solarmonitor/SolarMonitor-RTL/app.py

# Automatischer Restart bei Fehlern
Restart=always
RestartSec=10

# Umgebungsvariablen
Environment="PATH=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=app.py"
Environment="FLASK_ENV=production"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solarmonitor-rtl

# Timeout und Process Handling
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target

[Unit]
Description=SolarMonitor PostgreSQL REST API Server
After=network.target
Wants=solarmonitor-app.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projekte/scanner/SolarMonitor-RTL
Environment="PATH=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin"
ExecStart=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin/python3 postgres_server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solarmonitor-postgres

[Install]
WantedBy=multi-user.target

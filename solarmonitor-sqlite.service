[Unit]
Description=SolarMonitor SQLite REST API Server
After=network.target
Wants=solarmonitor-app.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL
Environment="PATH=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL/venv/bin"
ExecStart=/home/pi/Projekte/solarmonitor/SolarMonitor-RTL/venv/bin/python3 sqlite_server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solarmonitor-sqlite

[Install]
WantedBy=multi-user.target

[Unit]
Description=SolarMonitor Flask REST API
After=network.target solarmonitor-sqlite.service
Wants=solarmonitor-sqlite.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projekte/scanner/SolarMonitor-RTL
Environment="PATH=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin:/usr/bin:/bin"
ExecStart=/home/pi/Projekte/scanner/SolarMonitor-RTL/venv/bin/python3 app.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solarmonitor-app

[Install]
WantedBy=multi-user.target
